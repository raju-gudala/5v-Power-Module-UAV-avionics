            (width 100000)
            (height 270000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r170_60
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r170_60))
          (noconnect (pad r170_60))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r170_60))
          (noconnect (pad r170_60))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r170_60))
          (noconnect (pad r170_60))
        )
